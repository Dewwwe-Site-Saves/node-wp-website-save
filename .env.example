# Directory holding the SQLite database, site clones and SharePoint certificates.
# Use an absolute path in Docker (mounted volume). Default: ./data
DATA_DIR=./data

# 32 bytes, hex encoded (64 characters). Generate with: openssl rand -hex 32
# Encrypts site passwords and the GitHub token at rest. Required in production.
ENCRYPTION_KEY=

# Signs session cookies. Generate with: openssl rand -hex 32. Required in production.
SESSION_SECRET=

# The session cookie is marked Secure in production (HTTPS only). Set to false only for an
# instance served over plain HTTP on a private network.
# SESSION_COOKIE_SECURE=false

# Timezone used by the scheduler to interpret cron expressions.
TZ=Europe/Paris

# Docker only. The image sets DATA_DIR=/data and PORT=3000 itself; the entrypoint runs the app as PUID:PGID (default 1000:1000), so the mounted data directory must be writable by that user. Secrets go in the Portainer stack environment, not in a file. Keep SESSION_COOKIE_SECURE unset (Secure cookie) behind an HTTPS reverse proxy.
# PUID=1000
# PGID=1000
