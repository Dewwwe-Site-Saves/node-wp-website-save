{
    "permissions": {
        "allow": [
            "Bash(npm run typecheck)",
            "Bash(npm run format:check)",
            "Bash(npm test*)",
            "Bash(npx vitest run*)",
            "Bash(npx prisma validate*)",
            "Bash(npx prisma format*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./data/**)",
            "Read(./config.json)",
            "Bash(npm run db:migrate*)",
            "Bash(npm run db:deploy*)",
            "Bash(npm run build*)",
            "Bash(npm run dev*)",
            "Bash(npm run start*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "out=$(npm run typecheck --silent 2>&1) || { printf '%s\\n' \"$out\" >&2; exit 2; }",
                        "timeout": 90
                    }
                ]
            }
        ]
    }
}
